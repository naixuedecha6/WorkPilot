# API Key 配置模板 — 复制为 .env 并填入真实值
# Spring Boot 不直接读 .env,这里仅作记录。
# 实际使用时通过系统环境变量传入,或修改 src/main/resources/application.yml。

# DeepSeek
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# PostgreSQL(生产)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workpilot
# SPRING_DATASOURCE_USERNAME=workpilot
# SPRING_DATASOURCE_PASSWORD=workpilot
